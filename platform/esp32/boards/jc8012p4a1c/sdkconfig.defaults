# Cấu hình riêng board JC8012P4A1C (ghi đè platform/esp32/sdkconfig.defaults).
# Nguồn tham chiếu: vendor/ + demo lvgl_demo_v9 / xiaozhi của hãng (ESP-IDF 5.4).
CONFIG_IDF_TARGET="esp32p4"
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

# ---- Chip ESP32-P4 rev v1.0 (log boot: "chip revision: v1.0") ----
# ESP-IDF 6.x mặc định chỉ hỗ trợ P4 >= v3.1 (phần cứng khác hẳn) -> bootloader sẽ từ chối chạy app.
# Họ < v3.0 và >= v3.0 loại trừ nhau; rev tối thiểu v0.1 như mặc định của IDF 5.4.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_1=y

# ---- Flash 16 MB, bảng phân vùng riêng (app 8 MB) ----
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="boards/jc8012p4a1c/partitions.csv"

# ---- PSRAM 200 MHz + cache L2 (framebuffer 800x1280 nằm trong PSRAM) ----
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=49152
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y

# ---- LVGL: màn lớn -> heap LVGL lớn hơn board 320x240 ----
CONFIG_LV_MEM_SIZE_KILOBYTES=128
# Nhịp refresh ~60 Hz (mặc định chung 20 ms = 50 Hz).
CONFIG_LV_DEF_REFR_PERIOD=16
# UI co giãn 150%: theme chọn font gần nhất 14/20/28 x 1.5 -> 22/30/42 (font nằm trong flash).
CONFIG_LV_FONT_MONTSERRAT_22=y
CONFIG_LV_FONT_MONTSERRAT_30=y
CONFIG_LV_FONT_MONTSERRAT_42=y
# Đo hiệu năng: FPS + CPU% của LVGL ở góc dưới phải (tắt/bật trong Settings > Display & Brightness).
CONFIG_LV_USE_SYSMON=y
CONFIG_LV_USE_PERF_MONITOR=y
CONFIG_LV_PERF_MONITOR_ALIGN_BOTTOM_RIGHT=y

# ---- Wi-Fi qua ESP32-C6 (esp_hosted, SDIO 4-bit, slot 1) ----
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=40000
CONFIG_ESP_HOSTED_SDIO_PIN_CMD=19
CONFIG_ESP_HOSTED_SDIO_PIN_CLK=18
CONFIG_ESP_HOSTED_SDIO_PIN_D0=14
CONFIG_ESP_HOSTED_SDIO_PIN_D1=15
CONFIG_ESP_HOSTED_SDIO_PIN_D2=16
CONFIG_ESP_HOSTED_SDIO_PIN_D3=17
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=54
# Mempool SDIO (~35 KB, DMA, căn 128 B) tạo trước app_main: RAM nội không còn khối đủ lớn -> assert lúc boot
# (esp_hosted 2.x). P4 cho DMA đọc PSRAM qua cache -> đặt buffer transport ở PSRAM.
CONFIG_ESP_HOSTED_MEMPOOL_PREFER_SPIRAM=y
