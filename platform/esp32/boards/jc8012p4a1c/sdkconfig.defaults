# Cấu hình riêng board JC8012P4A1C (ghi đè platform/esp32/sdkconfig.defaults).
# Nguồn tham chiếu: vendor/ + demo lvgl_demo_v9 / xiaozhi của hãng (ESP-IDF 5.4).
CONFIG_IDF_TARGET="esp32p4"
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

# ---- Chip ESP32-P4 rev v1.0 (log boot: "chip revision: v1.0") ----
# ESP-IDF 6.x mặc định chỉ hỗ trợ P4 >= v3.1 (phần cứng khác hẳn) -> bootloader sẽ từ chối chạy app.
# Họ < v3.0 và >= v3.0 loại trừ nhau; rev tối thiểu v0.1 như mặc định của IDF 5.4.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_1=y

# ---- Flash 16 MB, bảng phân vùng riêng (app 8 MB) ----
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="boards/jc8012p4a1c/partitions.csv"

# ---- PSRAM 200 MHz + cache L2 (framebuffer 800x1280 nằm trong PSRAM) ----
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=49152
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y

# ---- LVGL: màn lớn -> heap LVGL lớn hơn board 320x240 ----
CONFIG_LV_MEM_SIZE=131072
# Heap LVGL qua malloc hệ thống (CONFIG_LV_USE_CLIB_MALLOC, đối tượng nhỏ vào RAM nội, dư sang PSRAM) đã đo
# (perf bench launcher, 2026-11-24): 43.9 ms so với 40.6 ms với pool 128 KiB -> CHẬM HƠN 8 %, lv_mem_monitor (gach
# health) mất số liệu -> giữ pool tĩnh. App vẫn bị giới hạn bởi pool này (MAX_OBJECTS 1024 là trần bảng handle).
# Nhịp refresh ~60 Hz (mặc định chung 20 ms = 50 Hz).
CONFIG_LV_DEF_REFR_PERIOD=16
# Vẽ song song (CONFIG_LV_OS_FREERTOS + CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2) đã đo (perf bench, vẽ lại toàn màn):
# CHẬM HƠN 37-60 % (launcher 34->47 ms, weather 76->112 ms; đổi priority draw thread không khác). Dải buffer
# 16 dòng chia khung thành nhiều draw task nhỏ: chi phí đồng bộ 2 thread + tranh cache lớn hơn lợi ích.
# OS + 1 unit: ngang hoặc chậm hơn ~10 %. -> Giữ LV_OS_NONE, 1 draw unit.
# PPA draw unit của LVGL 9.6 (CONFIG_LV_USE_PPA) đã đo: CHẬM HƠN 10-35 % (phép PPA chặn CPU + đồng bộ
# cache mỗi lần tô, chỉ nhận ô chữ nhật không bo góc) -> không bật. PPA chỉ dùng để xoay khi flush.
# UI co giãn 150%: theme chọn font gần nhất 14/20/28 x 1.5 -> 22/30/42 (font nằm trong flash).
CONFIG_LV_FONT_MONTSERRAT_22=y
CONFIG_LV_FONT_MONTSERRAT_30=y
CONFIG_LV_FONT_MONTSERRAT_42=y
# Đo hiệu năng: FPS + CPU% của LVGL ở góc dưới phải (tắt/bật trong Settings > Display & Brightness).
CONFIG_LV_USE_SYSMON=y
CONFIG_LV_USE_PERF_MONITOR=y
CONFIG_LV_PERF_MONITOR_ALIGN_BOTTOM_RIGHT=y

# ---- Wi-Fi qua ESP32-C6 (esp_hosted, SDIO 4-bit, slot 1) ----
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=40000
CONFIG_ESP_HOSTED_SDIO_PIN_CMD=19
CONFIG_ESP_HOSTED_SDIO_PIN_CLK=18
CONFIG_ESP_HOSTED_SDIO_PIN_D0=14
CONFIG_ESP_HOSTED_SDIO_PIN_D1=15
CONFIG_ESP_HOSTED_SDIO_PIN_D2=16
CONFIG_ESP_HOSTED_SDIO_PIN_D3=17
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=54
# Mempool SDIO (~35 KB, DMA, căn 128 B) tạo trước app_main: RAM nội không còn khối đủ lớn -> assert lúc boot
# (esp_hosted 2.x). P4 cho DMA đọc PSRAM qua cache -> đặt buffer transport ở PSRAM.
CONFIG_ESP_HOSTED_MEMPOOL_PREFER_SPIRAM=y

# ---- System Monitor: tải CPU từng core (bộ đếm idle FreeRTOS, nguồn esp_timer µs, 64-bit không tràn) ----
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U64=y

# ---- Cho phép .bss trong PSRAM: runtime (128 slot app) chuyển qua platform/esp32/main/runtime_psram.lf ----
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# ---- Phân core: UI (LVGL + Lua) ghim core 1; mạng (lwip, HTTP/TLS), debug bridge, esp_timer ở core 0 ----
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y

# ---- gach shell: heap trace (`gach heap trace ...`, tìm rò rỉ) ----
CONFIG_HEAP_TRACING_STANDALONE=y
# Muốn trace ghi được NƠI GỌI malloc (RISC-V cần frame pointer), thêm 3 dòng dưới rồi fullclean + build:
#   CONFIG_ESP_SYSTEM_USE_FRAME_POINTER=y
#   CONFIG_HEAP_TRACING_STACK_DEPTH=4
#   CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y   (frame pointer làm bootloader vượt 0x6000 byte trước bảng phân vùng)
# Đã đo: -14,6 KB RAM nội, vẽ lại chậm ~8 % -> chỉ bật khi dò rò rỉ.

# ---- Chẩn đoán: core dump vào flash khi panic (`gach crash info | dump | clear`) ----
# Phân vùng `coredump` 128 KB ở cuối bảng phân vùng (sau factory): NVS và app không dịch chuyển.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_SHA256=y

