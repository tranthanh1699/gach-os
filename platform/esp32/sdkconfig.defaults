# ==============================================================================
# Cấu hình chung cho mọi board họ ESP32. Board ghi đè ở boards/<board>/sdkconfig.defaults
# ==============================================================================

# ---- Build ----
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# ---- RTOS ----
# Tick 1 ms: osal::tick_ms() làm nguồn tick cho LVGL.
CONFIG_FREERTOS_HZ=1000
# 6 KiB: app_main còn cài gói + quét thẻ SD lúc boot (giải phóng khi app_main return).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# ---- LVGL 9 ----
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_BUILTIN_MALLOC=y
CONFIG_LV_MEM_SIZE=49152
CONFIG_LV_DEF_REFR_PERIOD=20
# IRAM dành cho Wi-Fi driver (tránh tràn iram0_0_seg trên ESP32).
CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=n
CONFIG_LV_USE_LOG=n
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_14=y
CONFIG_LV_USE_MSGBOX=y

# ---- Network ----
CONFIG_LV_USE_KEYBOARD=y
CONFIG_LV_USE_TEXTAREA=y
CONFIG_LV_USE_LIST=y
CONFIG_LV_USE_DROPDOWN=y
# Đồng bộ lại giờ NTP mỗi giờ (ms).
CONFIG_LWIP_SNTP_UPDATE_DELAY=3600000

# ---- Thẻ SD (FAT) cho app cài thêm ----
# Tên file dài (id gói dạng com.example.app) -> cần LFN.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=64
